# ---- Database ----
# Leave empty for local dev: an embedded PGlite database is created in ./.pglite automatically.
# For Neon (free): copy the POOLED connection string from the Neon dashboard.
DATABASE_URL=

# ---- Cloudinary (free; required for uploads, ingest, comparisons, reports) ----
# Either the single URL from the Cloudinary dashboard...
CLOUDINARY_URL=
# ...or the three parts separately.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder in the media library.
CLOUDINARY_FOLDER=fieldproof
# Auto-tagging add-on. Enable one in Cloudinary > Add-ons (free tier), then set: google_tagging | imagga_tagging | aws_rek_tagging
CLOUDINARY_AUTO_TAGGING=
CLOUDINARY_AUTO_TAGGING_THRESHOLD=0.6
# Cloudinary AI captioning add-on (true/false).
CLOUDINARY_CAPTIONING=false

# ---- Model provider: set ONE of these. Gemini has a free tier with no card. ----
# Google AI Studio key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Free tier: lite models answer reliably, full flash models mostly return 503. Tried in order on 429/503/timeouts.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# Anthropic (paid). If both keys are set, Anthropic is used unless LLM_PROVIDER=gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# LLM_PROVIDER=gemini | anthropic   (optional override)
# EMBEDDING_PROVIDER=gemini | voyage (optional override; default: voyage if key set, else gemini)

# ---- Voyage AI (optional). Gemini already provides embeddings; only set this if you prefer Voyage. ----
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
