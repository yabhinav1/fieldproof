# ---- Database ----
# Leave empty for local dev: an embedded PGlite database is created in ./.pglite automatically.
# For Neon: copy the pooled connection string from the Neon dashboard.
DATABASE_URL=

# ---- Cloudinary (required for uploads, ingest, comparisons, reports) ----
# Either the single URL from the Cloudinary dashboard...
CLOUDINARY_URL=
# ...or the three parts separately.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder in the media library.
CLOUDINARY_FOLDER=fieldproof
# Auto-tagging add-on. Enable one in Cloudinary > Add-ons, then set it here: google_tagging | imagga_tagging | aws_rek_tagging
CLOUDINARY_AUTO_TAGGING=
CLOUDINARY_AUTO_TAGGING_THRESHOLD=0.6
# Cloudinary AI captioning add-on (true/false).
CLOUDINARY_CAPTIONING=false

# ---- Anthropic (before/after analysis and report narrative) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Voyage AI (semantic search embeddings). Optional: without it search is keyword-only. ----
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
